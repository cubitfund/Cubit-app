{
  "name": "cubit-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:build-modes": "node scripts/check-build-modes.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "gen-abi": "node scripts/gen-abi.mjs",
    "sync-deployment": "node scripts/sync-deployment.mjs",
    "check": "node scripts/gen-abi.mjs --check && node scripts/sync-deployment.mjs --check && tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
